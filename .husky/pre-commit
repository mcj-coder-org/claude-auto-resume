#!/bin/sh

# Prerequisite checks
if ! command -v node >/dev/null 2>&1; then
  echo "Error: Node.js is required but not installed."
  echo "Install Node.js v22+ from https://nodejs.org/"
  exit 1
fi

if [ ! -d "node_modules" ]; then
  echo "Error: Dependencies not installed."
  echo "Run 'npm install' to install required packages."
  exit 1
fi

# Block commits directly to main
branch="$(git rev-parse --abbrev-ref HEAD)"
if [ "$branch" = "main" ]; then
  echo "Direct commits to main are not allowed."
  echo "Create a feature branch and open a PR instead."
  exit 1
fi

# Format and lint staged files
npx lint-staged

# Scan staged files for secrets
staged_count=$(git diff --cached --name-only --diff-filter=ACM | wc -l)
if [ "$staged_count" -gt 0 ]; then
  echo "Scanning staged files for secrets..."
  git diff --cached --name-only --diff-filter=ACM | xargs npx secretlint
  if [ $? -ne 0 ]; then
    echo "Secret scan failed. Remove secrets before committing."
    exit 1
  fi
fi
